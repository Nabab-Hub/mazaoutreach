# ==============================================================================
# Agentic Client Outreach Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Fill in your credentials for the respective services.
# Note: For security, never commit `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEMO CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the web dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to run in local mock/demo mode without connecting to live Firebase/APIs.
# Perfect for inspecting the UI, testing CSV import, and reviewing the dashboard.
NEXT_PUBLIC_DEMO_MODE=false


# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Web SDK)
# Required for dashboard authentication (Firebase Auth) and client-side subscriptions.
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890


# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CONFIGURATION (Server-Side)
# Required for secure API routes, server actions, and Cloud Functions.
# Obtain from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key should include the -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- headers.
# Replace newlines with \n if placing in a single line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"


# ------------------------------------------------------------------------------
# 4. GMAIL API & GOOGLE OAUTH2 (Multi-Account Sender & Poller)
# Required for connecting sender Gmail accounts and reading replies.
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Make sure OAuth Consent Screen is published to "In production" to avoid 7-day token expiration.
# Authorized Redirect URI: http://localhost:3000/api/gmail/oauth/callback (or your production URL)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback


# ------------------------------------------------------------------------------
# 5. SECURITY & ENCRYPTION
# Required to encrypt Gmail OAuth refresh tokens at rest in Firestore (AES-256-GCM).
# Generate a 32-byte hex key: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_secret_key_64_characters_long


# ------------------------------------------------------------------------------
# 6. AI PROVIDERS (Provider-Agnostic Router)
# Configurable per task in settings: personalization, classification, reply drafting.
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended for personalization & fast classification)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (GPT-4o, GPT-4o-mini)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Grok (xAI API - OpenAI compatible)
# Get key at: https://console.x.ai/
GROK_API_KEY=your_xai_grok_api_key_here


# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & INSTANT ALERTS
# Triggered when hot leads reply as "interested" or ask questions needing human approval.
# ------------------------------------------------------------------------------
# Telegram Bot Token (Create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (Your personal Telegram ID or notification group ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Owner Email address for instant alerts and daily digest
OWNER_EMAIL=owner@example.com


# ------------------------------------------------------------------------------
# 8. BUSINESS & BOOKING DEFAULTS
# ------------------------------------------------------------------------------
# Link included in AI replies for interested leads to schedule a discovery call
CALENDAR_BOOKING_LINK=https://calendly.com/your-username/15min
